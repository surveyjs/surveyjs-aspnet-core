# docker compose only: copy to .env next to docker-compose.yml. .env is git-ignored and holds only the private keys;
# every other setting is in appsettings.json, which the image includes. (`dotnet run` doesn't read this file: keep the
# keys in user secrets, `dotnet user-secrets set AI_API_KEY <key>`.)

# Commercial examples (Dashboard, Creator) run without a key and show a licence banner
SURVEYJS_LICENSE_KEY=

# Extract Responses from Documents: the SurveyJS service's key. With a key and no provider set, the service uses
# that key's provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translate with AI: the key for the endpoint in appsettings.json (AI_BASE_URL)
AI_API_KEY=

# Compose can't read appsettings.json: to pick the service's provider or model, or to use Ollama, set these here
# (or in your shell) as well as in appsettings.json
# SURVEYJS_AI_PROVIDER=ollama
# SURVEYJS_AI_MODEL=
# SURVEYJS_OLLAMA_BASE_URL=http://host.docker.internal:11434
