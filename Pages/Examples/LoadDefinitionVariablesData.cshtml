@page "/examples/load-definition-variables-data"
@model LoadDefinitionVariablesDataModel
@{
    // Demo only: this page also serves the embedded-schema example at /claim
    var optionA = Model.OptionA;
    var record = HttpContext.Request.Query["record"].FirstOrDefault() ?? "";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
    var records = optionA ? [] : await Model.RecordsAsync("claim", "customer_email", customerEmail: email ?? "");
    const string selected = "flex items-center rounded px-2.5 py-1 no-underline bg-sjs-dark text-white";
    const string unselected = "flex items-center rounded px-2.5 py-1 no-underline text-gray-700 hover:bg-gray-100";
}

@section description {
    <p>Load form schemas and user variables from your ASP.NET Core backend, either embedded in HTML or fetched from an API. Use variables to personalize form text and control question visibility, and restore saved answers through the API to prefill the form.</p>
}

@section head {
    @if (optionA)
    {
        @* Embed the schema and user variables as JSON escaped for an inline script *@
        <script>
            window.FORM_DEFINITION = @Json.Serialize(Model.Definition);
            window.FORM_VARIABLES = @Json.Serialize(Model.Variables);
        </script>
    }
}

@section tryThis {
    <li>Choose <strong>Schema embedded in HTML</strong> to receive the schema and user variables with the page, or <strong>Load from the API</strong> to fetch them and any saved answers in a separate request. You can inspect the API call in <strong>Requests</strong>.</li>
    <li>Switch <strong>Customer</strong> between Alice and Bob. User variables personalize the title with their name and plan and show priority handling only for the premium plan.</li>
    <li>When using <strong>Load from the API</strong>, you can select a <strong>Saved response</strong> to prefill the form with the customer's answers.</li>
    <li>Press <strong>Submit claim</strong> to save a new response. Open <strong>Data</strong> to inspect the saved answers; user variables are excluded.</li>
    <li>Press <strong>Start over</strong> to clear the form and the saved response selection.</li>
}

@section demoUserControl {
    <label class="flex items-center gap-2">
        <span class="text-gray-600">Customer</span>
        <select id="demo-user" data-reset-query="record" class="box-border h-9 rounded-md border border-gray-300 bg-white px-2 text-sm">
            <option value="alice" selected="@(email == "alice@example.com")">Alice (premium)</option>
            <option value="bob" selected="@(email == "bob@example.com")">Bob (basic)</option>
        </select>
    </label>
}

@section actions {
    <span class="box-border inline-flex min-h-9 max-w-full items-stretch rounded-md border border-gray-300 bg-white p-0.5" role="group" aria-label="Schema delivery">
        <a href="/claim" aria-current="@(optionA ? "page" : null)" class="@(optionA ? selected : unselected)">Schema embedded in HTML</a>
        <a href="/examples/load-definition-variables-data" aria-current="@(optionA ? null : "page")" class="@(optionA ? unselected : selected)">Load from the API</a>
    </span>
    @if (!optionA)
    {
        <form method="get" class="flex items-center gap-2">
            <label for="record" class="text-gray-600">Saved response</label>
            <select id="record" name="record" onchange="this.form.submit()" class="box-border h-9 rounded-md border border-gray-300 bg-white px-2 text-sm">
                <option value="">New response</option>
                @foreach (var (id, label) in records)
                {
                    <option value="@id" selected="@(id.ToString() == record)">@label</option>
                }
            </select>
        </form>
    }
    @await Html.PartialAsync("_StartOver", false)
}
